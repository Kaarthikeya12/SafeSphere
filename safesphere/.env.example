# Copy to .env.local and fill in. Never commit real values.

# ── Auth (Better Auth) ─────────────────────────────────────────────
# Random 32+ byte secret used to sign cookies/tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-with-a-long-random-string
# Public base URL of the app (must match the Google redirect URI host).
BETTER_AUTH_URL=http://localhost:3000

# ── Google OAuth (optional; Google button is disabled without these) ──
# Redirect URI to register in Google Cloud: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── AI incident assistant (optional; rule-based baseline without it) ──
ANTHROPIC_API_KEY=sk-ant-your-key
# Optional model override (default: claude-opus-5-5)
# SAFESPHERE_AI_MODEL=claude-opus-5-5

# ── Storage (optional) ─────────────────────────────────────────────
# SQLite file path. Default: ./data/safesphere.db
# SAFESPHERE_DB_PATH=./data/safesphere.db
